DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Hebron
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///db.sqlite3
REDIS_URL=redis://localhost:6379/0
DJANGO_ANON_THROTTLE_RATE=60/min
DJANGO_USER_THROTTLE_RATE=180/min
DJANGO_LOGIN_THROTTLE_RATE=5/min
DJANGO_REGISTER_THROTTLE_RATE=3/min
DJANGO_REFRESH_THROTTLE_RATE=10/min
DJANGO_PASSWORD_CHANGE_THROTTLE_RATE=5/hour
DJANGO_MESSAGE_SEND_THROTTLE_RATE=30/min
DJANGO_CONVERSATION_CREATE_THROTTLE_RATE=10/hour
DJANGO_NOTIFICATION_READ_THROTTLE_RATE=120/min
DJANGO_ADMIN_VERIFICATION_THROTTLE_RATE=30/hour
